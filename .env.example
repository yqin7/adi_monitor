# MongoDB 连接字符串（从 MongoDB Atlas 获取）
# 格式：mongodb+srv://用户名:密码@集群地址/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Slack Webhook URL（从 Slack 应用市场获取）
# 步骤：Slack Workspace Settings → Apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack 用户 ID（可选，用于 @mention）
# 步骤：在 Slack 中点击用户名 → View profile → 最下方可看到 U123456... 格式的 ID
SLACK_USER_ID=U123456789

# ===== 得物 =====
# 海外开放平台 POIZON（open.poizon.com）—— 项目实际调用的这套：
# 货号→skuId(接口140)、批量最低价(141)、批量30天销量(159)。签名鉴权，无需 token。
DEWU_INTL_APP_KEY=
DEWU_INTL_APP_SECRET=

# 国内开放平台 open.dewu.com —— 备用，目前项目未调用。
# 商家侧接口，没有行情价，只适合货号→spu/sku/官方价档案；走 OAuth 授权码换 token，
# 且调用 IP 需加入应用白名单。流程见 dewu-monitor 仓库 README_DEWU_CN.md。
DEWU_APP_KEY=
DEWU_APP_SECRET=
DEWU_SANDBOX_APP_KEY=
DEWU_SANDBOX_APP_SECRET=
DEWU_AUTH_CODE=
DEWU_REDIRECT_URI=

# ===== 抓取闸门 =====
# 本地一律 false：所有 Adidas/得物 抓取入口直接拒绝。只有服务器 docker-compose.prod.yml 里是 true。
SCRAPE_ALLOWED=false

# ===== Adidas 抓取代理（可选）=====
# 机房 IP 直连 adidas 官网容易被 Akamai 拦，云上建议走美国住宅代理。
# 只影响 Adidas 抓取；得物接口和 MongoDB 始终直连。留空或 PROXY_ENABLED=0 即直连。
PROXY_ENABLED=0
PROXY_PROTOCOL=socks5h   # socks5 会自动升成 socks5h（由代理解析域名），否则 Adidas 的 CDN 节点从代理出口连不上
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Python 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# Python 不缓冲输出（Docker 中推荐）
PYTHONUNBUFFERED=1
