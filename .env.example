# MongoDB 连接字符串（从 MongoDB Atlas 获取）
# 格式：mongodb+srv://用户名:密码@集群地址/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Slack Webhook URL（从 Slack 应用市场获取）
# 步骤：Slack Workspace Settings → Apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack 用户 ID（可选，用于 @mention）
# 步骤：在 Slack 中点击用户名 → View profile → 最下方可看到 U123456... 格式的 ID
SLACK_USER_ID=U123456789

# Python 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# Python 不缓冲输出（Docker 中推荐）
PYTHONUNBUFFERED=1

# 得物开放平台 (open.dewu.com) 凭证
DEWU_APP_KEY=your_production_app_key
DEWU_APP_SECRET=your_production_app_secret
DEWU_SANDBOX_APP_KEY=your_sandbox_app_key
DEWU_SANDBOX_APP_SECRET=your_sandbox_app_secret
# OAuth 回调地址，需与开放平台「应用信息 → 调回地址」完全一致
DEWU_REDIRECT_URI=https://your-domain/dewu/oauth/callback
# access_token 本地缓存文件（默认 .dewu_token.json）
DEWU_TOKEN_FILE=.dewu_token.json
# token 网关路径，按官方文档覆盖
# token 接口路径已由官方 SDK 确认，无需配置
